# Copy to .env and adjust. All values are optional; defaults shown.

# SQLite database file
DB_PATH=./data/alleyoop.db

# Web server
HOST=127.0.0.1
PORT=8000

# Comma-separated origins allowed for CORS. Set to your public URL, e.g. https://nba.example.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Per-IP rate limit for API data endpoints (slowapi syntax). Search has its own 120/minute limit.
RATE_LIMIT=60/minute

# Expose /api/docs (Swagger). Keep false on the public site.
ENABLE_DOCS=false

# Default "Last N games" window
DEFAULT_LAST_N=5

# Ingestion: seasons (newest first; the first is treated as the current season) and season types
SEASONS=2026-27,2025-26,2024-25
SEASON_TYPES=Regular Season,Playoffs

# nba_api politeness / reliability
NBA_TIMEOUT=60
NBA_RETRIES=4
NBA_DELAY_SECONDS=4
# Optional HTTP(S) proxy if stats.nba.com blocks or hangs on your IP
NBA_PROXY=

# Docker only: host port the web container is published on (127.0.0.1:HOST_PORT)
HOST_PORT=8000
# Docker only: hour (UTC) the ingest container runs the daily incremental update
INGEST_HOUR_UTC=9
