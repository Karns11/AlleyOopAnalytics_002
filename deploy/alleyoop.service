# /etc/systemd/system/alleyoop.service
[Unit]
Description=Alley Oop Analytics web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/AlleyOopAnalytics
EnvironmentFile=/home/pi/AlleyOopAnalytics/.env
# Single worker keeps RAM low on the Pi; bound to localhost so only cloudflared can reach it.
ExecStart=/home/pi/AlleyOopAnalytics/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/AlleyOopAnalytics/data
MemoryMax=300M

[Install]
WantedBy=multi-user.target
